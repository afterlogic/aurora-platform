parameters:
	editorUrl: 'code -r -g %%file%%:%%line%%'
	level: 2
	paths:
		- modules
		- system
	excludePaths:
		- modules/OAuthIntegratorWebclient/Classes/OAuthClient
		- modules/TwoFactorAuth/Classes/WebAuthn
		- modules/AdminPanelWebclient/vue/node_modules
		- modules/CoreUserGroups
		- modules/CoreUserGroupsLimits
		- modules/Licensing/classes/KI.php
	universalObjectCratesClasses:
		- Sabre\VObject\Property
		- Sabre\VObject\Component
		- Sabre\VObject\Component\VCard
		- \Sabre\VObject\Component\VEvent
		- \Sabre\VObject\Component\VCalendar
	# AU_APP_ROOT_PATH is define()d at runtime in system/Api.php; modules analysed on their own (pre-commit hook) don't see it
	ignoreErrors:
		-
			message: '#Constant AU_APP_ROOT_PATH not found#'
			reportUnmatched: false
